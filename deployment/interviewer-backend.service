[Unit]
Description=Interviewer Backend (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/interviewer/backend
Environment="PATH=/home/ubuntu/interviewer/backend/.venv/bin:/usr/bin"
ExecStart=/home/ubuntu/interviewer/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
